<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="704.0" prefWidth="1222.0" spacing="10.0" styleClass="root" stylesheets="@../../../CssStyle/home.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.loginController">
   <children>
      <HBox alignment="TOP_RIGHT" maxWidth="Infinity">
         <children>
            <Button mnemonicParsing="false" onAction="#closeButton" styleClass="btn-secondary" text="✕ Exit" />
            <Region prefWidth="20.0" />
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </HBox>
      <ImageView fitHeight="102.0" fitWidth="242.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../logowithoutbg.png" />
         </image>
      </ImageView>
      <VBox maxWidth="400.0" spacing="8.0" styleClass="card-solid">
         <children>
            <Text fill="#374a72" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="subtitle" text="Username / Email Address" />
            <TextField fx:id="useremailLogin" maxWidth="Infinity" prefHeight="40.0" promptText="admin1234 / admin04@gmail.com" styleClass="text-input" />
            <Text fill="#374a72" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="subtitle" text="Password">
               <VBox.margin>
                  <Insets top="12.0" />
               </VBox.margin>
            </Text>
            <PasswordField fx:id="passwordLogin" maxWidth="Infinity" prefHeight="40.0" promptText="••••••" styleClass="text-input" />
            <HBox alignment="CENTER_RIGHT">
               <children>
                  <Hyperlink onAction="#forgotpassword" text="Forgot Password?" />
               </children>
            </HBox>
            <Button fx:id="login" defaultButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#loginButton" styleClass="btn-primary" text="Login">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
            <HBox alignment="CENTER">
               <children>
                  <Hyperlink onAction="#cAAButton" text="Create An Account" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
         </padding>
         <VBox.margin>
            <Insets top="30.0" />
         </VBox.margin>
      </VBox>
   </children>
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="20.0" />
   </padding>
</VBox>
