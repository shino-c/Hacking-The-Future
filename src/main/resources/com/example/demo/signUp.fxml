                           <VBox.margin>
                              <Insets top="4.0" />
                           </VBox.margin>
                        </TextField>
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <VBox>
                     <children>
                        <Text fill="#374a72" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="subtitle" text="Longitude (Y) :" />
                        <TextField fx:id="longitude" editable="false" maxWidth="Infinity" prefHeight="28.0" styleClass="text-input">
