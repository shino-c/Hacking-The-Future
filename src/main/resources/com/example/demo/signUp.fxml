                  <Insets left="16.0" right="16.0" />
               </VBox.margin>
            </Text>
            <Text fill="#374a72" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="subtitle" text="Email Address" wrappingWidth="377.0">
               <VBox.margin>
                  <Insets left="16.0" top="8.0" />
               </VBox.margin>
            </Text>
            <TextField fx:id="emailSignUp" onInputMethodTextChanged="#emailValidation" onKeyTyped="#emailValidation" maxWidth="Infinity" prefHeight="28.0" promptText="admin04@gmail.com" styleClass="text-input">
