<VBox fx:id="stage" alignment="CENTER" fillWidth="false" prefHeight="520.0" prefWidth="621.0" styleClass="root" stylesheets="@../../../CssStyle/home.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.signUpController">
