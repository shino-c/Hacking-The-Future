<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="root" stylesheets="@../../../CssStyle/home.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.bookingController">
   <top>
      <HBox alignment="CENTER_LEFT" maxWidth="Infinity" minHeight="64.0" maxHeight="64.0" prefHeight="64.0" spacing="6.0" styleClass="nav-bar" BorderPane.alignment="CENTER">
         <children>
            <ImageView fitHeight="48.0" fitWidth="130.0" pickOnBounds="true" preserveRatio="true" styleClass="logo">
               <image>
                  <Image url="@../../../logowithoutbg.png" />
               </image>
               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin>
            </ImageView>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#homeButton" styleClass="barItem" text="Home" />
            <Button mnemonicParsing="false" onAction="#quizButton" styleClass="barItem" text="Quiz" />
            <Button mnemonicParsing="false" onAction="#eventButton" styleClass="barItem" text="Event" />
            <Button mnemonicParsing="false" onAction="#bookingButton" styleClass="barItem,active" text="Booking" />
            <Button mnemonicParsing="false" onAction="#leaderBoardButton" styleClass="barItem" text="LeaderBoard" />
            <Button mnemonicParsing="false" onAction="#profileButton" styleClass="barItem" text="Profile" />
            <Button mnemonicParsing="false" onAction="#logOutButton" styleClass="barItem" text="Log Out" />
         </children>
         <padding>
            <Insets bottom="6.0" right="12.0" top="6.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <VBox alignment="TOP_CENTER" spacing="16.0" BorderPane.alignment="TOP_CENTER">
         <children>
            <Text fill="#374a72" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="title-center" text="Booking">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Text>
            <HBox alignment="TOP_CENTER" maxWidth="1100.0" spacing="20.0">
               <children>
                  <!-- Left card: destination + available time slots -->
                  <VBox spacing="12.0" styleClass="card-solid" HBox.hgrow="ALWAYS">
                     <children>
                        <Text fill="#374a72" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="subtitle" text="📍 Destination" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <ChoiceBox fx:id="destinationChoiceBox" maxWidth="Infinity" prefHeight="56.0" styleClass="choice-round" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <Text fill="#374a72" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="subtitle" text="🕐 Available Time Slots">
                           <VBox.margin>
                              <Insets top="8.0" />
                           </VBox.margin>
                        </Text>
                        <TextArea fx:id="timeSlotsTextArea" editable="false" wrapText="true" prefHeight="300.0" styleClass="text-input" VBox.vgrow="ALWAYS" />
                     </children>
                     <padding>
                        <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
                     </padding>
                  </VBox>
                  <!-- Right card: booking details -->
                  <VBox maxWidth="420.0" minWidth="380.0" spacing="12.0" styleClass="card-solid">
                     <children>
                        <Text fill="#374a72" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="subtitle" text="🧒 Booking For" />
                        <ChoiceBox fx:id="childChoiceBox" maxWidth="Infinity" prefHeight="38.0" styleClass="choice-round" />
                        <Text fill="#374a72" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="subtitle" text="⏰ Select Time Slot">
                           <VBox.margin>
                              <Insets top="8.0" />
                           </VBox.margin>
                        </Text>
                        <ChoiceBox fx:id="timeSlotBooking" maxWidth="Infinity" prefHeight="38.0" styleClass="choice-round" />
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#bookDestination" styleClass="btn-primary" text="Confirm Booking">
                           <VBox.margin>
                              <Insets top="18.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                     <padding>
                        <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="30.0" left="60.0" right="60.0" top="24.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
